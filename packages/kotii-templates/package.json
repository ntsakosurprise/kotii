{
  "name": "kotii-templates",
  "version": "1.0.0-beta.2.0",
  "description": "a lightweight template provider for the Kotii ecosystem.It delivers ready-to-use **SSR (Server-Side Rendering)** and **SPA (Single-Page Application)** templates, supporting both **JavaScript** and **TypeScript** project setups",
  "author": "ntsakosurprise <mashelesepru@gmail.com>",
  "homepage": "https://github.com/ntsakosurprise/kotii",
  "type": "module",
  "engines": {
    "node": ">=17.2.0",
    "yarn": ">=1.22.11",
    "npm": ">=8.19.2"
  },
  "exports": {
    ".": {
      "import": "./index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.cjs"
    }
  },
  "scripts": {
    "babel-transpile": "cd packages/kotii && node transpile_kotii.js",
    "build:api": "tsc -b ./tsconfig.json",
    "bootstrap": "lerna bootstrap",
    "clean": "lerna run --parallel clean",
    "release": "lerna publish",
    "start": "cd packages/kotii && node kotii.cjs start",
    "start:dev": "cd packages/kotii && NODE_OPTIONS=--import=./compile/register_hooks.cjs node app.js start",
    "start:prod": "node app.js start",
    "build": "cd packages/kotii && node kotii.cjs build",
    "webpack": "webpack ",
    "commit": "commit",
    "test": "npx lerna run test",
    "compile:esm": "cross-env NODE_ENV=development NODE_MODE=esm webpack",
    "compile:cjs": "cross-env NODE_ENV=development NODE_MODE=cjs webpack"
  },
  "license": "ISC",
  "readmeFilename": "README.md",
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "anzii": "8.0.1",
    "kotii-logger": "1.0.0-beta.2.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.24.8",
    "@babel/core": "^7.25.2",
    "babel-loader": "^9.1.3",
    "cross-env": "^7.0.3",
    "webpack": "^5.93.0",
    "webpack-cli": "^5.1.4",
    "webpack-node-externals": "^3.0.0"
  },
  "files": [
    "dist/",
    "javascript/",
    "typescript/",
    "index.js",
    "package.json",
    "plugins/",
    "README.md"
  ]
}
