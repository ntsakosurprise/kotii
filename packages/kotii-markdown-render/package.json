{
  "name": "kotii-markdown-render",
  "version": "1.0.0-beta.1.0",
  "description": "a lightweight and flexible routing library for modern JavaScript and TypeScript applications. It provides declarative routing components and powerful hooks to manage navigation, route matching, and redirection.",
  "author": "ntsakosurprise <mashelesepru@gmail.com>",
  "homepage": "https://github.com/kotii",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.cjs"
    }
  },
  "directories": {
    "lib": "dist",
    "test": "__tests__"
  },
  "files": [
    "dist/",
    "index.js",
    "src/",
    "README.md",
    "package.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:tsc": "tsc -b",
    "clean": "rimraf lib coverage tsconfig.tsbuildinfo",
    "build": "webpack --mode production",
    "compile:esm": "cross-env NODE_ENV=development NODE_MODE=esm webpack",
    "compile:cjs": "cross-env NODE_ENV=development NODE_MODE=cjs webpack"
  },
  "devDependencies": {
    "@babel/core": "^7.17.5",
    "@babel/preset-env": "^7.16.11",
    "@babel/preset-react": "^7.16.7",
    "@storybook/cli": "^7.1.0",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.4.3",
    "@types/jest": "^29.5.3",
    "@types/styled-components": "^5.1.26",
    "babel-cli": "^6.26.0",
    "babel-loader": "^8.2.3",
    "cross-env": "^7.0.3",
    "jest": "^29.5.0",
    "jest-environment-jsdom": "^29.6.1",
    "source-map-loader": "^4.0.1",
    "ts-jest": "^29.1.1",
    "ts-loader": "^9.4.4",
    "ts-node": "^10.9.1",
    "webpack": "^5.69.1",
    "webpack-cli": "^4.9.2",
    "webpack-dev-server": "^4.7.4",
    "webpack-node-externals": "^3.0.0"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "dependencies": {
    "debug": "^4.4.0"
  }
}
