{
  "name": "kotii-runtime",
  "version": "1.0.0-beta.1.0",
  "description": "is the **production runtime layer** of the Kotii Framework",
  "homepage": "https://github.com/ntsakosurprise/kotii",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./plugins": {
      "import": "./plugins/index.js",
      "require": "./plugins/index.js",
      "default": "./plugins/index.js"
    }
  },
  "scripts": {
    "lint": "eslint .",
    "test": "NODE_OPTIONS='--experimental-vm-modules --no-warnings=ExperimentalWarning' jest",
    "start:dev:nodemon": "nodemon index",
    "compile:cjs": "cross-env NODE_ENV=development NODE_MODE=cjs webpack"
  },
  "keywords": [
    "scripts",
    "kotii",
    "react scripts",
    "scaffold"
  ],
  "repository": {
