    "url": "https://www.twitter.com/ntsakosurprise"
  },
  "contributors": [
    {
      "name": "Surprise Mashele",
      "email": "mashelesepru@gmail.com"
    }
  ],
  "license": "MIT",
  "dependencies": {
    "@kotii/anzii-plugins-env": "1.0.0-beta.1.0",
    "@kotii/anzii-plugins-filerouter": "file:/Users/surprisemashele/Documents/kotii/packages/kotii-anzii-plugins-filerouter/kotii-anzii-plugins-filerouter-1.0.0-beta.1.0.tgz",
    "@kotii/anzii-plugins-react": "file:/Users/surprisemashele/Documents/kotii/packages/kotii-anzii-plugins-react/kotii-anzii-plugins-react-1.0.0-beta.1.0.tgz",
    "@kotii/anzii-plugins-viewguard": "1.0.0-beta.1.0",
