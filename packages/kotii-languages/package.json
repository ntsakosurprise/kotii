{
  "name": "kotii-languages",
  "version": "1.0.0-beta.3.0",
  "description": "is a lightweight and flexible library for managing multilingual support in your React applications.",
  "author": "ntsakosurprise <mashelesepru@gmail.com>",
  "homepage": "https://github.com/kotii",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist/",
    "src/",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "start": "webpack-dev-server --watch",
    "build": "webpack --mode production",
    "compile:esm": "cross-env NODE_ENV=development NODE_MODE=esm webpack",
    "compile:cjs": "cross-env NODE_ENV=development NODE_MODE=cjs webpack"
  },
  "dependencies": {
    "i18next": "^21.8.14",
    "kotii-utils": "1.0.0-beta.2.0",
    "react-i18next": "^11.18.1",
    "react-icons": "^4.12.0",
    "react-select": "^5.4.0",
    "kotii-styled": "1.0.0-beta.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.17.5",
    "@babel/preset-env": "^7.16.11",
    "@babel/preset-react": "^7.16.7",
    "babel-cli": "^6.26.0",
    "babel-loader": "^8.2.3",
    "cross-env": "^10.0.0",
    "jest": "^29.5.0",
    "style-loader": "^3.3.1",
    "webpack": "^5.69.1",
    "webpack-cli": "^4.9.2",
    "webpack-dev-server": "^4.7.4"
  }
}
