    "arg": "^4.1.3",
    "kotii-auth": "1.0.0-beta.3.0",
    "kotii-components": "1.0.0-beta.1.0",
    "kotii-head": "file:/Users/surprisemashele/Documents/kotii/packages/kotii-head/kotii-head-1.0.0-beta.1.0.tgz",
    "kotii-runtime": "1.0.0-beta.1.0"
  },
