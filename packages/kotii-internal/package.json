    "@babel/plugin-transform-strict-mode": "^7.10.4",
    "@babel/plugin-transform-typescript": "^7.26.8",
    "@babel/preset-env": "^7.23.2",
    "@babel/preset-react": "^7.22.15",
    "@babel/traverse": "7.28.5",
    "@eslint/js": "^9.21.0",
