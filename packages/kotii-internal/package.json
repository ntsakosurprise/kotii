{
  "name": "kotii-internal",
  "version": "1.0.0-beta.1.0",
  "description": "is a next-generation full-stack meta-framework for building modern web applications It combines a powerful compiler pipeline, flexible backend architecture, file-based routing, and first-class React support — all built on top of the Anzii framework and its event-driven, plugin-powered architecture.",
  "main": "./dist/index.js",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./app": {
      "import": "./dist/app.js",
      "require": "./dist/router.cjs"
    },
    "./hot": {
      "import": "./dist/build.js",
      "require": "./dist/router.cjs"
    },
    "./root": {
      "import": "./internal.js",
      "require": "./dist/router.cjs"
    },
    "./user": {
      "import": "./user.js",
      "require": "./dist/router.cjs"
    }
  },
  "scripts": {
    "lint": "eslint .",
    "test": "NODE_OPTIONS='--experimental-vm-modules --no-warnings=ExperimentalWarning' jest",
    "prepack": "echo 'Running prepack script: Compiling source files and creating minified versions.' && pnpm run babel-transpile",
    "babel-transpile": "node transpile_kotii.js"
  },
  "keywords": [
    "scripts",
    "kotii",
    "react scripts",
    "scaffold"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ntsakosurprise/kotii"
  },
  "author": {
    "email": "mashelesepru@gmail.com",
