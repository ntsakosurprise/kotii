{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "lib",
    "ignoreDeprecations": "6.0",
    "skipLibCheck": true,
    "rootDir": "./",

    "allowJs": true,
    "baseUrl": "./",
    "module": "CommonJS"
    // "paths": {
    //   "Config": ["src/config/"],
    //   "Hooks": ["src/hooks/index"],
    //   "Components": ["src/components/index"],
    //   "Types": ["src/types"],
    //   "Context": ["src/context/"],
    //   "Constants": ["./src/constants/*"]
    // }
  },

  "include": ["src/**/*", "jest-setup.ts"],
  "exclude": [
    "node_modules",
    "../**/node_modules",
    "lib" // Exclude your outDir to prevent infinite loop compilation
