{
  "name": "@kotii/anzii-plugins-viewguard",
  "version": "1.0.0-beta.1.0",
  "description": "is a Node.js plugin for the Anzii backend framework that provides view-level authentication for server-side rendered (SSR) applications",
  "author": "ntsakosurprise <mashelesepru@gmail.com>",
  "homepage": "https://github.com/ntsakosurprise/kotii",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "import": "./src/index.js",
      "require": "./src/index.js",
      "default": "./src/index.js"
    }
  },
  "directories": {
    "lib": "dist",
    "test": "__tests__"
  },
  "files": [
    "src/",
    "README.md",
    "package.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "compile:esm": "cross-env NODE_ENV=development NODE_MODE=esm webpack",
    "compile:cjs": "cross-env NODE_ENV=development NODE_MODE=cjs webpack"
  },
  "peerDependencies": {
    "anzii": "8.0.1"
  }
}
