{
  "name": "@kotii/anzii-plugins-react",
  "version": "1.0.0-beta.4.0",
  "description": "A full-featured React Server-Side Rendering (SSR), SPA rendering, static rendering, and effects-driven data loader plugin for the **Anzii Framework** built for kotii.",
  "author": "ntsakosurprise <mashelesepru@gmail.com>",
  "homepage": "https://github.com/ntsakosurprise/kotii",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "import": "./src/index.js",
      "require": "./src/index.js",
      "default": "./src/index.js"
    }
  },
  "directories": {
    "lib": "dist",
    "test": "__tests__"
  },
  "files": [
    "src/",
    "README.md",
    "package.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "compile:esm": "cross-env NODE_ENV=development NODE_MODE=esm webpack",
    "compile:cjs": "cross-env NODE_ENV=development NODE_MODE=cjs webpack"
  },
  "dependencies": {
    "kotii-components": "1.0.0-beta.3.0",
    "kotii-head": "1.0.0-beta.1.0",
    "kotii-internal": "1.0.0-beta.3.0",
    "kotii-router": "1.0.0-beta.3.0",
    "kotii-styled": "1.0.0-beta.7.0",
    "serialize-javascript": "^6.0.1"
  },
  "peerDependencies": {
    "anzii": "8.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.17.5",
    "@babel/preset-env": "^7.16.11",
    "@babel/preset-react": "^7.16.7",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.4.3",
    "@types/jest": "^29.5.3",
    "@types/styled-components": "^5.1.26",
    "babel-cli": "^6.26.0",
    "babel-loader": "^8.2.3",
    "cross-env": "^7.0.3",
    "jest": "^29.5.0",
    "jest-environment-jsdom": "^29.6.1",
    "webpack": "^5.69.1",
    "webpack-cli": "^4.9.2",
    "webpack-dev-server": "^4.7.4",
    "webpack-node-externals": "^3.0.0"
  }
}
