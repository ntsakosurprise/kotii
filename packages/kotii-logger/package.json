{
  "name": "kotii-logger",
  "version": "1.0.0-beta.2.0",
  "description": "a flexible and lightweight logger for JavaScript/Node.js projects, supporting namespaces and environment-based log level control.",
  "author": "ntsakosurprise <mashelesepru@gmail.com>",
  "homepage": "https://github.com/ntsakosurprise/kotii",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "import": "./index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.cjs"
    }
  },
  "directories": {
    "lib": "dist",
    "test": "__tests__"
  },
  "files": [
    "dist/",
    "index.js",
    "src/",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:tsc": "tsc -b",
    "compile:esm": "cross-env NODE_ENV=development NODE_MODE=esm webpack",
    "compile:cjs": "cross-env NODE_ENV=development NODE_MODE=cjs webpack"
  },
  "devDependencies": {
    "@babel/core": "^7.17.5",
    "@babel/preset-env": "^7.16.11",
    "@babel/preset-react": "^7.16.7",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.4.3",
    "@types/jest": "^29.5.3",
    "babel-cli": "^6.26.0",
    "babel-loader": "^8.2.3",
    "cross-env": "^7.0.3",
    "jest-environment-jsdom": "^29.6.1",
    "source-map-loader": "^4.0.1",
    "ts-jest": "^29.1.1",
    "webpack": "^5.69.1",
    "webpack-cli": "^4.9.2",
    "webpack-node-externals": "^3.0.0"
  },
  "dependencies": {
    "debug": "^4.4.0"
  }
}
