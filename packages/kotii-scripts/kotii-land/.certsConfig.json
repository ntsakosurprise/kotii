{
  "actions": [
    {
      "action": "generate-rsa",
      "options": {
        "outputPath": "ssl/generated-key.pem",
        "text": true,
        "keyBitsLength": 2048
      }
    },
    {
      "action": "create-certificate-signing-request",
      "options": {
        "new": true,
        "sha256": true,
        "text": true,
        "key-source": "ssl/generated-key.pem",
        "outputPath": "ssl/generated-csr.csr"
      }
    },
    {
      "action": "create-self-signed-certificate-request",
      "options": {
        "x509": true,
        "sha256": true,
        "text": true,
        "days": 31,
        "key-source": "ssl/generated-key.pem",
        "input-source": "ssl/generated-csr.csr",
        "outputPath": "ssl/generated-certificate.pem"
      }
    }
  ]
}
