{
  "name": "kotii-utils",
  "version": "1.0.0-beta.5.0",
  "description": "a lightweight JavaScript utility library that provides helpful functions for string manipulation and local storage management. Perfect for small projects or quick utilities.",
  "author": "ntsakosurprise <mashelesepru@gmail.com>",
  "homepage": "https://github.com/kotii",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "import": "./src/index.js",
      "require": "./dist/index.cjs",
      "default": "./src/index.js"
    }
  },
  "files": [
    "dist/",
    "src/",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "start": "webpack-dev-server --watch",
    "compile:esm": "cross-env NODE_ENV=development NODE_MODE=esm webpack",
    "compile:cjs": "cross-env NODE_ENV=development NODE_MODE=cjs webpack",
    "test": "jest"
  },
  "devDependencies": {
    "@babel/core": "^7.17.5",
    "@babel/preset-env": "^7.16.11",
    "@babel/preset-react": "^7.16.7",
    "babel-cli": "^6.26.0",
    "babel-loader": "^8.2.3",
    "cross-env": "^10.0.0",
    "jest": "^29.5.0",
    "jest-environment-jsdom": "^29.6.1",
    "webpack": "^5.69.1",
    "webpack-cli": "^4.9.2"
  }
}
