{
  "name": "kotii-styled",
  "version": "1.0.0-beta.4.0",
  "description": "a wrapper around the official styled-components",
  "homepage": "https://github.com/kotii",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "type": "module",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.ts",
      "require": "./dist/index.cjs",
      "default": "./index.ts"
    }
  },
  "author": {
    "email": "mashelesepru@gmail.com",
    "name": "Ntsako Surpris Mashele",
    "url": "http://iiprodakts.io"
  },
  "contributors": [
    {
      "name": "Surprise Mashele",
      "email": "mashelesepru@gmail.com",
      "website": "https://www.nstakosurprise.com"
    }
  ],
  "license": "MIT",
  "scripts": {
    "compile:esm": "cross-env NODE_ENV=development NODE_MODE=esm webpack",
    "compile:cjs": "cross-env NODE_ENV=development NODE_MODE=cjs webpack",
    "build:types": "tsc"
  },
  "peerDependencies": {
    "styled-components": "^6.1.11"
  },
  "readme": "See README file",
  "readmeFilename": "README.md",
  "bugs": {
    "url": "https://github.com/ntsakosurprise/kotii/kotii-styled/issues"
  },
  "files": [
    "src/",
    "dist/",
    "lib/",
    "index.js",
    "index.d.ts",
    "package.json",
    "kotii.svg",
    "dist",
    "README.md",
    "LICENSE.md"
  ],
  "devDependencies": {
    "@babel/core": "^7.17.5",
    "@babel/preset-env": "^7.16.11",
    "@babel/preset-react": "^7.16.7",
    "@babel/preset-typescript": "^8.0.1",
    "@types/react": "^18.0.0 || ^19.0.0",
    "babel-cli": "^6.26.0",
    "babel-loader": "^8.2.3",
    "cross-env": "^10.0.0",
    "jest": "^29.5.0",
    "jest-environment-jsdom": "^29.6.1",
    "ts-loader": "^9.6.2",
    "webpack": "^5.69.1",
    "webpack-cli": "^4.9.2"
  }
}
